# Go binary and test artifacts
/q
/q.new
/q.pre-go
*.test
*.out

# Runtime cache (produced by q on first run)
/cache/

# Shipped snippet library — override the user's global *.yaml exclude
# so these payload catalogs stay tracked in the repo.
!builders/**/*.yaml

# CI workflows — also excluded by the user's global *.yml rule, so
# re-include the whole .github tree explicitly.
!.github/
!.github/**
